# ====================================================================
#  Recorrido Virtual 360 — configuracion de la carpeta (Apache/LiteSpeed)
#  Objetivo: que el tour cargue bien en cualquier hosting compartido.
# ====================================================================

# Archivo de inicio
DirectoryIndex index.html

# Redirige la carpeta sin "/" final a la version con "/" (rutas relativas OK)
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# --- Desactiva la cache de LiteSpeed SOLO para esta carpeta ---
# Evita que el servidor siga mostrando una version vieja o un 404 cacheado.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# --- Tipos MIME correctos (por si el servidor no los reconoce) ---
<IfModule mod_mime.c>
  AddType application/javascript        .js
  AddType text/css                      .css
  AddType image/svg+xml                 .svg
  AddType font/woff2                    .woff2
  AddType application/json              .json
  AddType image/jpeg                    .jpg .jpeg
  AddType image/png                     .png
  AddType image/webp                    .webp
</IfModule>

# --- Permite el acceso a todos los archivos del tour ---
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
